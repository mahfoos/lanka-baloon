// Lanka Ballooning (Pvt) Ltd — one schema for both apps.
//
// The public website writes Booking and ContactMessage rows; the ERP reads and
// works every model here. Both connect through the pooler at runtime
// (DATABASE_URL); migrations use the direct connection (DIRECT_URL), because
// pgbouncer cannot run them.

generator client {
  provider = "prisma-client-js"
  // Generated into the package rather than a hoisted node_modules, so pnpm's
  // isolated layout can't leave one app resolving a stale client.
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Currency is per row, not global: the website quotes in USD and the office
/// works in rupees. Storing one number without saying which unit it is would
/// silently corrupt every total, and a hard-coded exchange rate would be worse.
enum Currency {
  LKR
  USD
}

/* ------------------------------------------------------------------ *
 * Bookings
 * ------------------------------------------------------------------ */

enum PackageType {
  SHARED_FLIGHT
  PRIVATE_FLIGHT
  MARRIAGE_PROPOSAL
  BIRTHDAY_CELEBRATION
  WEDDING_ANNIVERSARY
  GIFT_VOUCHER
}

enum BookingStatus {
  ENQUIRY
  PENDING_PAYMENT
  CONFIRMED
  FLOWN
  CANCELLED
  WEATHER_HOLD
  REFUNDED
}

enum BookingSource {
  WEBSITE
  PHONE
  EMAIL
  WALK_IN
  TRAVEL_AGENT
  HOTEL_CONCIERGE
}

model Booking {
  id           String        @id @default(uuid())
  /// Human reference shown to the guest, e.g. SLB-2026-0042.
  ref          String        @unique
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId   String?
  /// Denormalised so a booking still reads correctly if the CRM record is merged
  /// or removed. The website has no customer record at the moment it books.
  customerName String
  email        String?
  phone        String?
  country      String?
  packageType  PackageType   @default(SHARED_FLIGHT)
  flightDate   DateTime      @db.Date
  flight       Flight?       @relation(fields: [flightId], references: [id], onDelete: SetNull)
  flightId     String?
  adults       Int           @default(1)
  children     Int           @default(0)
  currency     Currency      @default(LKR)
  pricePerHead Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount   Decimal       @default(0) @db.Decimal(12, 2)
  status       BookingStatus @default(ENQUIRY)
  source       BookingSource @default(WEBSITE)
  /// Website extras, kept as flags so the office sees them without parsing notes.
  giftVoucher  Boolean       @default(false)
  birthdayCake Boolean       @default(false)
  specialOccasion String?
  hotel        String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  transactions Transaction[]
  vouchers     Voucher[]

  @@index([flightDate])
  @@index([status])
  @@index([createdAt])
}

/* ------------------------------------------------------------------ *
 * Website contact form
 * ------------------------------------------------------------------ */

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/* ------------------------------------------------------------------ *
 * Flights
 * ------------------------------------------------------------------ */

enum FlightStatus {
  SCHEDULED
  BOARDING
  IN_FLIGHT
  COMPLETED
  CANCELLED_WEATHER
  POSTPONED
}

model Flight {
  id           String       @id @default(uuid())
  code         String       @unique
  date         DateTime     @db.Date
  launchTime   String
  launchSite   String
  balloon      Balloon?     @relation(fields: [balloonId], references: [id], onDelete: SetNull)
  balloonId    String?
  pilot        CrewMember?  @relation(fields: [pilotId], references: [id], onDelete: SetNull)
  pilotId      String?
  capacity     Int          @default(0)
  status       FlightStatus @default(SCHEDULED)
  windSpeedKts Int?
  windDirection String?
  durationMins Int?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// `booked` is derived from these rather than stored, so it can't drift.
  bookings     Booking[]

  @@index([date])
  @@index([status])
}

/* ------------------------------------------------------------------ *
 * Fleet
 * ------------------------------------------------------------------ */

enum BalloonManufacturer {
  ULTRAMAGIC
  LINDSTRAND
}

enum BalloonStatus {
  AIRWORTHY
  IN_MAINTENANCE
  GROUNDED
  RETIRED
}

model Balloon {
  id                  String              @id @default(uuid())
  registration        String              @unique
  name                String
  manufacturer        BalloonManufacturer
  model               String
  envelopeVolumeM3    Int                 @default(0)
  basketCapacity      Int                 @default(0)
  yearBuilt           Int?
  totalFlightHours    Decimal             @default(0) @db.Decimal(10, 1)
  status              BalloonStatus       @default(AIRWORTHY)
  airworthinessExpiry DateTime?           @db.Date
  lastInspection      DateTime?           @db.Date
  hasSafetyBelts      Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  flights             Flight[]
  maintenanceLogs     MaintenanceLog[]
}

/* ------------------------------------------------------------------ *
 * Crew
 * ------------------------------------------------------------------ */

enum CrewRole {
  COMMERCIAL_PILOT
  CO_PILOT
  GROUND_CREW_LEAD
  GROUND_CREW
  CHASE_DRIVER
  RETRIEVE_CREW
}

enum CrewStatus {
  ACTIVE
  ON_LEAVE
  OFF_SEASON
  INACTIVE
}

model CrewMember {
  id               String     @id @default(uuid())
  empId            String     @unique
  name             String
  role             CrewRole
  status           CrewStatus @default(ACTIVE)
  licenseNo        String?
  licenseExpiry    DateTime?  @db.Date
  validationExpiry DateTime?  @db.Date
  yearsExperience  Int        @default(0)
  totalFlightHours Decimal?   @db.Decimal(10, 1)
  phone            String?
  email            String?
  joinDate         DateTime?  @db.Date
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  flights          Flight[]
}

/* ------------------------------------------------------------------ *
 * Customers
 * ------------------------------------------------------------------ */

enum CustomerType {
  TOURIST
  LOCAL
  CORPORATE
  TRAVEL_AGENT
}

model Customer {
  id        String       @id @default(uuid())
  name      String
  type      CustomerType @default(TOURIST)
  country   String?
  email     String?
  phone     String?
  /// Totals are computed from bookings on read, not stored, so they can't go stale.
  firstSeen DateTime     @default(now())
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  bookings  Booking[]

  @@index([email])
}

/* ------------------------------------------------------------------ *
 * Ground transport
 * ------------------------------------------------------------------ */

enum VehicleType {
  PASSENGER_VAN
  CHASE_4X4
  RECOVERY_TRUCK
  CAR
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  SERVICING
  OFF_ROAD
}

model Vehicle {
  id                   String           @id @default(uuid())
  registration         String           @unique
  type                 VehicleType
  makeModel            String
  seats                Int              @default(0)
  hasAirConditioning   Boolean          @default(true)
  status               VehicleStatus    @default(AVAILABLE)
  revenueLicenseExpiry DateTime?        @db.Date
  insuranceExpiry      DateTime?        @db.Date
  lastServiceOdo       Int              @default(0)
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  maintenanceLogs      MaintenanceLog[]
}

/* ------------------------------------------------------------------ *
 * Gift vouchers
 * ------------------------------------------------------------------ */

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

model Voucher {
  id                String        @id @default(uuid())
  code              String        @unique
  packageType       PackageType   @default(GIFT_VOUCHER)
  purchaserName     String
  recipientName     String?
  currency          Currency      @default(LKR)
  amount            Decimal       @default(0) @db.Decimal(12, 2)
  issuedDate        DateTime      @default(now()) @db.Date
  expiryDate        DateTime      @db.Date
  status            VoucherStatus @default(ACTIVE)
  redeemedBooking   Booking?      @relation(fields: [redeemedBookingId], references: [id], onDelete: SetNull)
  redeemedBookingId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
}

/* ------------------------------------------------------------------ *
 * Finance
 * ------------------------------------------------------------------ */

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  ONLINE_GATEWAY
  AGENT_CREDIT
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(uuid())
  date        DateTime        @db.Date
  type        TransactionType
  /// A PackageType label for income, an expense category for expense.
  category    String
  currency    Currency        @default(LKR)
  amount      Decimal         @db.Decimal(12, 2)
  method      PaymentMethod   @default(BANK_TRANSFER)
  reference   String?
  description String?
  booking     Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([type])
}

/* ------------------------------------------------------------------ *
 * Maintenance
 * ------------------------------------------------------------------ */

enum MaintenanceAssetType {
  BALLOON
  VEHICLE
}

enum MaintenanceType {
  ANNUAL_INSPECTION
  ENVELOPE_REPAIR
  BURNER_SERVICE
  BASKET_SERVICE
  VEHICLE_SERVICE
  FUEL_SYSTEM_CHECK
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model MaintenanceLog {
  id            String               @id @default(uuid())
  assetType     MaintenanceAssetType
  balloon       Balloon?             @relation(fields: [balloonId], references: [id], onDelete: Cascade)
  balloonId     String?
  vehicle       Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId     String?
  type          MaintenanceType
  status        MaintenanceStatus    @default(SCHEDULED)
  scheduledDate DateTime             @db.Date
  completedDate DateTime?            @db.Date
  currency      Currency             @default(LKR)
  cost          Decimal?             @db.Decimal(12, 2)
  engineer      String?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([scheduledDate])
  @@index([status])
}

/* ------------------------------------------------------------------ *
 * Compliance
 * ------------------------------------------------------------------ */

enum ComplianceKind {
  AIR_OPERATOR_CERTIFICATE
  AIRCRAFT_REGISTRATION
  AIRWORTHINESS_CERTIFICATE
  PILOT_LICENCE
  VALIDATION_CERTIFICATE
  INSURANCE_POLICY
  VEHICLE_REVENUE_LICENCE
}

model ComplianceRecord {
  id         String         @id @default(uuid())
  kind       ComplianceKind
  reference  String
  authority  String
  /// Balloon registration, pilot name or "Company": free text because a
  /// certificate can point at any of them.
  relatesTo  String
  issuedDate DateTime?      @db.Date
  /// Status (Valid / Expiring Soon / Expired) is derived from this on read.
  expiryDate DateTime       @db.Date
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([expiryDate])
}

/* ------------------------------------------------------------------ *
 * Reviews
 * ------------------------------------------------------------------ */

model Review {
  id        String   @id @default(uuid())
  author    String
  country   String?
  rating    Int      @default(5)
  title     String
  body      String
  source    String   @default("TripAdvisor")
  date      DateTime @db.Date
  flightRef String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
