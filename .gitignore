# Dependencies — hoisted to the root by npm workspaces, but nested copies happen
# whenever two apps need different versions of the same package.
node_modules/

# Next.js build output
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Secrets. .env.example files are committed on purpose — they carry no values.
.env
.env.local
.env*.local

# Hosting
.vercel

# macOS
.DS_Store
*.textClipping

# Source spreadsheets from the office. These carry real guest names, phone
# numbers and financial figures, and git history is permanent: once pushed,
# deleting them later does not remove them. Keep them out of the repo.
req/
