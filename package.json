{
  "name": "lanka-baloon",
  "version": "1.0.0",
  "private": true,
  "description": "Sri Lanka Balloon — public website and operations ERP for Lanka Ballooning (Pvt) Ltd",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "pnpm --filter @lanka-baloon/landing dev",
    "dev:landing": "pnpm --filter @lanka-baloon/landing dev",
    "dev:admin": "pnpm --filter @lanka-baloon/admin dev",
    "build": "pnpm --recursive --if-present build",
    "build:landing": "pnpm --filter @lanka-baloon/landing build",
    "build:admin": "pnpm --filter @lanka-baloon/admin build",
    "start:landing": "pnpm --filter @lanka-baloon/landing start",
    "start:admin": "pnpm --filter @lanka-baloon/admin start",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "engines": {
    "node": ">=18.18"
  }
}
