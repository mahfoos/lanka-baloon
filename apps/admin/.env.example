# Both apps read the same database. Copy to .env.local, or symlink the repo-root
# .env.local here (which is what the local setup does):
#   ln -sf ../../.env.local apps/admin/.env.local
#
# From Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL is the pooled connection used at runtime (port 6543).
# DIRECT_URL is the direct connection, needed for migrations (port 5432).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Signs the ERP session cookie. Any long random string: `openssl rand -hex 32`.
# Required in production; falls back to a dev default locally.
AUTH_SECRET=
