# Copy to .env.local and fill in.

# Signs the ERP session cookie. Any long random string — `openssl rand -hex 32`.
# Required in production; falls back to a dev default locally.
AUTH_SECRET=

# The public website's Supabase project, for the Website Bookings module.
# Project Settings -> API in the Supabase dashboard.
#
# SERVICE ROLE KEY — bypasses Row Level Security. Server-side only, never
# NEXT_PUBLIC_*, never committed. Leave both blank to run the ERP without the
# Website Bookings module.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
