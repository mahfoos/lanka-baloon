# Both apps read the same database. Copy to .env.local, or symlink the repo-root
# .env.local here (which is what the local setup does):
#   ln -sf ../../.env.local apps/landing/.env.local
#
# Used server-side only, by the booking and contact form actions.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Public site URL (used for sitemap + metadata)
NEXT_PUBLIC_SITE_URL=https://www.srilankaballoon.com
